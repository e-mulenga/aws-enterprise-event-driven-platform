environment = "test"

landing_zone_state_bucket = "REPLACE-ME-state-bucket"
landing_zone_state_key    = "landing-zone/test/terraform.tfstate"
landing_zone_state_region = "us-east-1"

primary_region = "af-south-1"
dr_region      = "eu-west-1"

kms_strategy = "aws-managed" # Test uses AWS-managed keys — see the cost-optimization statement in docs/cost-analysis.md

event_retention_days            = 14
enable_cross_region_replication = false
enable_dlq                       = true
enable_event_replay              = true
enable_global_tables             = false
message_retention_seconds        = 345600
dlq_max_receive_count            = 5

enable_xray_tracing       = true
enable_managed_grafana    = false
lambda_log_retention_days = 30
alert_email                = ""

enable_ai_integration = true  # test is where AI event-routing is exercised before prod
enable_custom_domain  = false

additional_tags = {
  Owner = "REPLACE-ME"
}
